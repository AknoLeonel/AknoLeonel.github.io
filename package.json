{
  "name": "aknoleonel-portfolio",
  "private": true,
  "type": "module",
  "description": "Portfólio de Leonel Paiva. Site estático servido pelo GitHub Pages.",
  "scripts": {
    "serve": "python3 -m http.server 4173",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "check": "npm run lint && npm run arch && npm run knip && npm test && npm run e2e",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@playwright/test": "^1.56.0",
    "@stryker-mutator/core": "^9.0.0",
    "@stryker-mutator/vitest-runner": "^9.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "dependency-cruiser": "^17.0.0",
    "jsdom": "^26.1.0",
    "knip": "^5.60.0",
    "vitest": "^3.2.0"
  }
}
